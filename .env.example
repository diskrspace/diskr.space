# Copy this file to .env for local development. Do not commit your real .env.
# Only connection and web listener settings belong here.
DISKRSPACE_DB_URI=sqlite:///./diskrspace.db
DISKRSPACE_WEB_IP=127.0.0.1
DISKRSPACE_WEB_PORT=1888

# PostgreSQL example:
# DISKRSPACE_DB_URI=postgresql+psycopg2://user:password@127.0.0.1:5432/diskrspace
